; Full-screen presenter for the DMP PICA200.

.fvec projection[4]

.constf constants(0.0, 1.0, 0.0, 0.0)
.alias zeros constants.xxxx
.alias ones  constants.yyyy

.out outpos position
.out outtc0 texcoord0

.alias inpos v0
.alias intex v1

.proc main
    mov r0.xyz, inpos
    mov r0.w, ones

    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0

    mov outtc0.xy, intex
    mov outtc0.zw, zeros
    end
.end
